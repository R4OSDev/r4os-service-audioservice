R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=AUDSVC
VERSION=0.1.3
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/AUDSVC.R4X
IMAGE_SCOPE=full
IMPORT=R4SYS:Query:1
IMPORT=R4AUDIO:Query:1
META=service.name=AUDSVC
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
